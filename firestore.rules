rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isProf() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['professor', 'admin'];
    }

    // Perfil da conta. Cada pessoa lê e atualiza o próprio. Professores (e admin) leem só alunos que
    // ligaram o compartilhamento. O papel 'admin' só pode ser definido manualmente no console do Firebase.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || (isProf() && resource.data.role == 'aluno' && resource.data.compartilhar == true)
        || (resource.data.role == 'aluno' && resource.data.visivelAlunos == true));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'role', 'nome', 'email', 'compartilhar'])
        && request.resource.data.role in ['aluno', 'professor']
        && request.resource.data.username is string && request.resource.data.username.size() <= 120
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.compartilhar is bool;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'curso', 'interesses', 'compartilhar', 'visivelAlunos', 'sobre', 'skills', 'email'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.curso is string && request.resource.data.curso.size() <= 80
        && request.resource.data.interesses is list && request.resource.data.interesses.size() <= 30
        && request.resource.data.compartilhar is bool
        && request.resource.data.visivelAlunos is bool
        && request.resource.data.sobre is string && request.resource.data.sobre.size() <= 300
        && request.resource.data.skills is string && request.resource.data.skills.size() <= 150
        && request.resource.data.email is string && request.resource.data.email.size() <= 120;
      allow delete: if false;
    }

    // Seleção de alunos feita por cada professor (só ele lê e grava a própria).
    match /selecoes/{uid} {
      allow read: if isProf() && request.auth.uid == uid;
      allow create, update: if isProf() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['alunos'])
        && request.resource.data.alunos is list && request.resource.data.alunos.size() <= 300;
    }

    // Vagas: o professor publica direto (status 'aprovada'), pode editar e apagar as próprias; o admin pode ocultar/apagar.
    match /vagas/{id} {
      allow read: if signedIn() && (resource.data.status == 'aprovada' || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['professor', 'admin']
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'aprovada'
        && request.resource.data.keys().hasOnly(['title','institution','areas','summary','requirements','scholarship','modality','location','deadline','contact','applicationUrl','tipo','ownerRole','ownerUid','ownerName','status','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.institution is string && request.resource.data.institution.size() <= 120
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 1500
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 400
        && request.resource.data.areas is list && request.resource.data.areas.size() <= 16;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['aprovada', 'recusada', 'pendente'])
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.keys().hasOnly(['title','institution','areas','summary','requirements','scholarship','modality','location','deadline','contact','applicationUrl','tipo','ownerRole','ownerUid','ownerName','status','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 150
          && request.resource.data.institution is string && request.resource.data.institution.size() <= 120
          && request.resource.data.summary is string && request.resource.data.summary.size() <= 1500
          && request.resource.data.contact is string && request.resource.data.contact.size() <= 400
          && request.resource.data.areas is list && request.resource.data.areas.size() <= 16);
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Avisos e eventos criados por professores: publicados direto; o dono edita e apaga; o admin pode ocultar/apagar.
    match /posts/{id} {
      allow read: if signedIn() && (resource.data.status == 'aprovada' || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isProf()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'aprovada'
        && request.resource.data.kind in ['evento', 'aviso']
        && request.resource.data.keys().hasOnly(['kind','title','etype','date','place','submitDeadline','text','url','contact','until','areas','ownerRole','ownerUid','ownerName','status','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.areas is list && request.resource.data.areas.size() <= 16;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['aprovada', 'recusada', 'pendente'])
        || (isProf() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.kind in ['evento', 'aviso']
          && request.resource.data.keys().hasOnly(['kind','title','etype','date','place','submitDeadline','text','url','contact','until','areas','ownerRole','ownerUid','ownerName','status','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.text is string && request.resource.data.text.size() <= 600
          && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
          && request.resource.data.areas is list && request.resource.data.areas.size() <= 16);
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Vínculo aluno–IC. O professor (dono da vaga) cria como 'convidado'; só o aluno convidado confirma.
    // Confirmados são visíveis para qualquer pessoa logada; os demais, só para as duas partes e o admin.
    match /vinculos/{id} {
      allow read: if signedIn() && (resource.data.status == 'confirmado' || resource.data.profUid == request.auth.uid
        || resource.data.alunoUid == request.auth.uid || isAdmin());
      allow create: if isProf()
        && request.resource.data.profUid == request.auth.uid
        && request.resource.data.status == 'convidado'
        && id == request.resource.data.vagaId + '_' + request.resource.data.alunoUid
        && request.resource.data.keys().hasOnly(['vagaId','vagaTitulo','profUid','profName','alunoUid','alunoNome','status','createdAt'])
        && request.resource.data.vagaTitulo is string && request.resource.data.vagaTitulo.size() <= 150
        && request.resource.data.profName is string && request.resource.data.profName.size() <= 80
        && request.resource.data.alunoNome is string && request.resource.data.alunoNome.size() <= 80
        && get(/databases/$(database)/documents/vagas/$(request.resource.data.vagaId)).data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.alunoUid == request.auth.uid
        && resource.data.status == 'convidado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'confirmado';
      allow delete: if signedIn() && (resource.data.alunoUid == request.auth.uid || resource.data.profUid == request.auth.uid || isAdmin());
    }
  }
}
